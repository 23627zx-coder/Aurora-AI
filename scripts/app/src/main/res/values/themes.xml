<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aurora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Android 12+ Core SplashScreen 主题 -->
    <style name="Theme.Aurora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- 仅包含静态丝带图形（不含文字），置于 192dp 圆形安全区内 -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_aurora_splash_static</item>
        <item name="postSplashScreenTheme">@style/Theme.Aurora</item>
    </style>
</resources>
